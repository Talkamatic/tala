{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Human-readable Ontology JSON",
  "type": "object",
  "required": ["ontology"],
  "properties": {
    "ontology": {"$ref": "#/$defs/ontology"}
  },
  "additionalProperties": false,
  "$defs": {
    "ontology": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": {"type": "string"},
        "sorts": {
          "type": "array",
          "items": {"$ref": "#/$defs/sort"}
        },
        "predicates": {
          "type": "array",
          "items": {"$ref": "#/$defs/predicate"}
        },
        "individuals": {
          "type": "array",
          "items": {"$ref": "#/$defs/individual"}
        },
        "actions": {
          "type": "array",
          "items": {"type": "string"}
        }
      },
      "additionalProperties": false
    },
    "sort": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": {"type": "string"},
        "dynamic": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "predicate": {
      "type": "object",
      "required": ["name", "sort"],
      "properties": {
        "name": {"type": "string"},
        "sort": {"type": "string"},
        "feature_of": {"type": "string"},
        "multiple_instances": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "individual": {
      "type": "object",
      "required": ["name", "sort"],
      "properties": {
        "name": {"type": "string"},
        "sort": {"type": "string"}
      },
      "additionalProperties": false
    }
  }
}
