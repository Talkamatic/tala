{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Human-readable DDD Bundle JSON",
  "oneOf": [
    {"$ref": "#/$defs/bundle"},
    {
      "type": "object",
      "required": ["ddd"],
      "properties": {
        "ddd": {"$ref": "#/$defs/bundle"}
      },
      "additionalProperties": false
    }
  ],
  "$defs": {
    "bundle": {
      "type": "object",
      "properties": {
        "schema_version": {"type": "string"},
        "ontology": {"$ref": "ontology.schema.json#/$defs/ontology"},
        "domain": {"$ref": "domain.schema.json#/$defs/domain"},
        "service_interface": {"$ref": "service_interface.schema.json#/$defs/service_interface"}
      },
      "required": ["ontology", "domain", "service_interface"],
      "additionalProperties": false
    }
  }
}
